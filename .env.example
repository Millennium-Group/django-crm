# Copy to .env and fill in. `docker compose` reads .env automatically.
#
# Generate the two secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# ---- required ----------------------------------------------------------
DJANGO_SECRET_KEY=change-me-generate-a-real-one
POSTGRES_PASSWORD=change-me-too

# ---- database ----------------------------------------------------------
POSTGRES_DB=crm
POSTGRES_USER=crm

# ---- http --------------------------------------------------------------
# host:port Caddy listens on inside its container (compose maps 8080 -> 80)
CRM_SITE_ADDRESS=:80
# port published on the host
CRM_HTTP_PORT=8080

# Host header(s) Django accepts. Add the name your reps will type.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,crm.local
# Only needed when served over https from a real domain, e.g.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com
# DJANGO_HTTPS=1

# ---- CRM url segments (keep them non-obvious) --------------------------
CRM_URL_PREFIX=123/
CRM_ADMIN_PREFIX=456-admin/
CRM_LOGIN_PREFIX=789-login/

# ---- identity used for loop detection / reply-to -----------------------
CRM_HOST=crm.local
CRM_IP=127.0.0.1

# ---- outbound mail (optional; the CRM can run without it) --------------
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=crm@example.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=CRM <crm@example.com>

# ---- tuning ------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
DJANGO_DEBUG=0
DJANGO_LOG_LEVEL=INFO
